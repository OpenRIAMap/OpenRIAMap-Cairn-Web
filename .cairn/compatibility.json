{
  "schemaVersion": "cairn.compatibility.v1",
  "reviewWorkflow": {
    "contractVersion": "review-workflow.v3",
    "supportedIntents": ["submit", "precheck", "approve", "reject", "request-changes", "archive", "status-refresh", "report-refresh"],
    "formalApprovalStates": ["awaiting-approval", "approved", "dispatch-queued", "dispatch-running", "completed"],
    "localStatusIsNotFormalApproval": true,
    "authorizationPolicy": "github-organization-teams.v1",
    "staticUsernameRoleBindingsAllowed": false
  },
  "reviewSubmission": {
    "versionedPackages": true,
    "stateVersionConflicts": "required",
    "browserControlRoute": "/api/review-control",
    "uiBindingIncluded": true,
    "packageContractVersion": "cairnmap.review-package.v1",
    "reviewMarkerSchemaVersion": "cairnmap.native-relay-review.v1",
    "legacyPackageImport": "compat-import-only",
    "strictSubmissionRequiresLocatedDeleteMarks": true
  },
  "reviewAuth": {
    "contractVersion": "cairnmap.review-auth-port.v1",
    "provider": "github-oauth-session",
    "sessionRoute": "/api/auth/github/session",
    "loginRoute": "/api/auth/github/start",
    "logoutRoute": "/api/auth/github/logout",
    "browserReceivesCloudCredentials": false
  },
  "dataSourceSelection": {
    "contractVersion": "cairnmap.data-source-selection.v1",
    "runtimeConfig": ".cairn/formal-data-source-runtime.json",
    "formalReaderSchemaVersion": "openriamap.formal-release-reader.v2",
    "defaultSourceId": "formal-cos",
    "automaticFallback": false,
    "cacheScope": ["sourceId", "releaseId", "worldId", "readerSchemaVersion"],
    "legacySourceLinkModeRemainsSeparate": true
  },
  "requiredChecks": ["validate:review-control-binding", "test:review-control-binding", "test:review-control-port", "validate:team-review-authorization", "validate:relay-review-status", "validate:native-relay-accept-guards", "test:data-source-selection", "test:formal-release-reader", "validate:formal-data-source-runtime", "test:review-package-contract", "test:review-package-profile-auth", "test:review-status-board"]
}
