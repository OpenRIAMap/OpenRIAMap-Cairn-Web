# Repository text is normalized on add; working-tree EOL remains a local Git choice.
* text=auto

# Text formats that must not rely on automatic content detection.
*.cjs text
*.cts text
*.css text
*.csv text
*.env text
*.geojson text
*.gitattributes text
*.gitignore text
*.html text
*.ini text
*.json text
*.jsonl text
*.jsx text
*.lock text
*.md text
*.mjs text
*.mts text
*.npmrc text
*.ps1 text
*.sh text
*.svg text
*.toml text
*.ts text
*.tsv text
*.tsx text
*.txt text
*.xml text
*.yaml text
*.yml text
.editorconfig text
.nvmrc text
.prettierignore text
.vercelignore text
Dockerfile text
LICENSE text
Makefile text
package-lock.json text

# Assets and archives are never subject to EOL conversion.
*.7z binary
*.avif binary
*.bmp binary
*.doc binary
*.docx binary
*.eot binary
*.gif binary
*.gz binary
*.ico binary
*.jpeg binary
*.jpg binary
*.mp3 binary
*.mp4 binary
*.ogg binary
*.otf binary
*.pdf binary
*.png binary
*.ppt binary
*.pptx binary
*.tar binary
*.tif binary
*.tiff binary
*.ttf binary
*.wav binary
*.webm binary
*.webp binary
*.woff binary
*.woff2 binary
*.xls binary
*.xlsx binary
*.zip binary

# Published config resources have byte hashes; checkout must preserve UTF-8 LF.
src/configStudio/defaults/*.json text eol=lf
docs/90_roadmap-and-history/runtime-v32-final-execution-20261012/*.config.json text eol=lf
docs/90_roadmap-and-history/runtime-v32-final-execution-20261012/r9-r5-delivery-manifest.json text eol=lf

# Historical blueprints carry byte hashes; preserve their original line endings.
docs/90_roadmap-and-history/RuntimeV32_Incremental_Revision_Blueprint_v*_History_*.md -text whitespace=cr-at-eol

# Frozen audit inputs are byte-hashed by the inherited r9 acceptance suite.
docs/90_roadmap-and-history/RuntimeV32_CategoryManagement_Prefill_Editing_Update_Blueprint_2026-10-12.md text eol=lf
docs/90_roadmap-and-history/runtime-v32-unified-repair-20261011/CairnMap_V32_FieldReuse_Drawing_r4.config.json text eol=lf

# Synchronization evidence is UTF-8 LF for reproducible byte digests.
docs/90_roadmap-and-history/runtime-v32-sync01-execution-20261014/*.json text eol=lf
docs/90_roadmap-and-history/runtime-v32-sync01-execution-20261014/*.txt text eol=lf

# Active adaptation blueprint and PR review evidence carry byte digests.
docs/90_roadmap-and-history/RuntimeV32_Incremental_Revision_Blueprint_2026-10-13.md text eol=lf
docs/90_roadmap-and-history/runtime-v32-downstream-pr-review-20261014/*.json text eol=lf

# C-stage application delivery resources have reproducible byte digests.
